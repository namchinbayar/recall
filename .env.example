# Atlas connection string. Atlas UI -> Cluster -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Voyage AI key. https://dash.voyageai.com/
VOYAGE_API_KEY=

# Optional: a database user given apart from the URI (replaces any login in MONGODB_URI).
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Optional overrides
RECALL_DB=recall
# Other databases on the cluster that search also reads and never writes (README: A private instance).
# RECALL_READ_DBS=recall
# Let `recall serve` store Hermes exchanges directly, for an instance without the event stream.
# RECALL_SERVE_STORE=1
RECALL_COLLECTION=chunks
RECALL_INDEX=vector_index
VOYAGE_MODEL=voyage-4
VOYAGE_DIMENSIONS=1024
# Keys issued from Atlas (AI Model APIs page) are geography scoped; the error
# message tells you which host. US keys use:
# VOYAGE_BASE_URL=https://us.ai.mongodb.com/v1

# Step three: the agent. Any Anthropic API key; the SDK reads this variable.
ANTHROPIC_API_KEY=
# Optional: model and effort for `recall chat` / `recall ask`
RECALL_MODEL=claude-opus-5-5
RECALL_EFFORT=medium
# Session notes (`recall sessions`): defaults to RECALL_MODEL at effort low.
# RECALL_SUMMARY_MODEL=claude-sonnet-5-5
# RECALL_SUMMARY_EFFORT=low

# Online MCP server (`recall mcp-online`, see the README). These go in their own file,
# ~/.config/recall/online.env; none of them is a secret.
# RECALL_ONLINE_URL=https://name.example/mcp          # the public address clients connect to
# RECALL_ONLINE_ISSUER=https://api.descope.com/v1/apps/<project id>
# RECALL_ONLINE_SUBJECTS=<your user id at the authorization server>[,<another>]
# RECALL_ONLINE_PORT=8791                             # local port the tunnel points at
